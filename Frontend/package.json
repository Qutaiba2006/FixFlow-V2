{
  "name": "fixflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "local-api": "node scripts/local-api.mjs",
    "test": "playwright test",
    "check-backend": "node scripts/check-backend.mjs",
    "local-accounts": "node -e \"console.log(require('fs').readFileSync('.local/test-accounts.json','utf8'))\"",
    "dev:connected": "node scripts/dev-connected.mjs",
    "check:startup": "node scripts/check-connected.mjs",
    "test:persistence": "node --test scripts/persistence.test.mjs",
    "test:config": "node --test scripts/api-config.test.mjs",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
